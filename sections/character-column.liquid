{% style %}

  [data-section-id="{{ section.id }}"] .character-column__row {
    display: grid;
    grid-template-columns: 1fr;
  }

  [data-section-id="{{ section.id }}"] .character-column__col {
    padding-top: {{ section.settings.padding_y_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  [data-section-id="{{ section.id }}"] .character-column__col-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  [data-section-id="{{ section.id }}"] .character-column__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem 2rem;
  }

  [data-section-id="{{ section.id }}"] .character-column__header {
    margin: 0;
    font-size: {{ section.settings.header_font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    [data-section-id="{{ section.id }}"] .character-column__header {
      font-size: {{ section.settings.header_font_size_desktop }}px;
    }
  }

  [data-section-id="{{ section.id }}"] .character-column__image-wrap {
    position: relative;
    height: 100%;
    min-height: 20rem;
  }

  [data-section-id="{{ section.id }}"] .character-column__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 990px) {
    [data-section-id="{{ section.id }}"] .character-column__row {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    }

    [data-section-id="{{ section.id }}"] .character-column__col-inner--single {
      max-width: 60%;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 989px) {
    [data-section-id="{{ section.id }}"] .character-column__col-inner {
      grid-template-columns: 1fr;
    }

    [data-section-id="{{ section.id }}"] .character-column__col {
      padding-top: {{ section.settings.padding_y_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    [data-section-id="{{ section.id }}"] .character-column__text {
      align-items: center;
      text-align: center;
    }
  }

{% endstyle %}

<section data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="character-column__row">
    {%- for block in section.blocks -%}
      <div class="character-column__col" style="background-color: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
        <div class="character-column__col-inner{% if section.blocks.size == 1 %} character-column__col-inner--single{% endif %}">
          <div class="character-column__text">
            {%- if block.settings.header != blank -%}
              <h2 class="character-column__header inline-richtext" style="color: {{ block.settings.header_color }};">{{ block.settings.header }}</h2>
            {%- endif -%}
            {%- if block.settings.button_text != blank -%}
              <a
                {% if block.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="button tj-new-button button--primary character-column__button"
                style="color: {{ block.settings.button_text_color }} !important; background-color: {{ block.settings.button_bg_color }} !important;"
              >
                {{- block.settings.button_text | escape -}}
              </a>
            {%- endif -%}
          </div>
          <div class="character-column__image-wrap">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500', alt: block.settings.image.alt
              }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Character Column",
  "enabled_on": {
    "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "range",
      "id": "padding_y_desktop",
      "label": "Padding top desktop (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Padding top mobile (px)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile (px)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "header_font_size_desktop",
      "label": "Header font size desktop (px)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "header_font_size_mobile",
      "label": "Header font size mobile (px)",
      "min": 16,
      "max": 80,
      "step": 1,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#FFFFFF"
        },
        {
          "type": "html",
          "id": "header",
          "label": "Header"
        },
        {
          "type": "color",
          "id": "header_color",
          "label": "Header color",
          "default": "#000000"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Character Column",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}

