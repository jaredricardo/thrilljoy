{% style %}

  [data-section-id="{{ section.id }}"] .character-column__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  [data-section-id="{{ section.id }}"] .character-column__col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: {{ section.settings.padding_y_desktop }}px;
  }

  [data-section-id="{{ section.id }}"] .character-column__col--1 {
    background-color: {{ section.settings.col_1_bg_color }};
  }

  [data-section-id="{{ section.id }}"] .character-column__col--2 {
    background-color: {{ section.settings.col_2_bg_color }};
  }

  [data-section-id="{{ section.id }}"] .character-column__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem 2rem;
  }

  [data-section-id="{{ section.id }}"] .character-column__header {
    margin: 0;
    font-size: {{ section.settings.header_font_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    [data-section-id="{{ section.id }}"] .character-column__header {
      font-size: {{ section.settings.header_font_size_desktop }}px;
    }
  }

  [data-section-id="{{ section.id }}"] .character-column__col--1 .character-column__header {
    color: {{ section.settings.col_1_header_color }};
  }

  [data-section-id="{{ section.id }}"] .character-column__col--2 .character-column__header {
    color: {{ section.settings.col_2_header_color }};
  }

  [data-section-id="{{ section.id }}"] .character-column__button--1 {
    color: {{ section.settings.col_1_button_text_color }} !important;
    background-color: {{ section.settings.col_1_button_bg_color }} !important;
  }

  [data-section-id="{{ section.id }}"] .character-column__button--2 {
    color: {{ section.settings.col_2_button_text_color }} !important;
    background-color: {{ section.settings.col_2_button_bg_color }} !important;
  }

  [data-section-id="{{ section.id }}"] .character-column__image-wrap {
    position: relative;
    height: 100%;
    min-height: 20rem;
  }

  [data-section-id="{{ section.id }}"] .character-column__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    [data-section-id="{{ section.id }}"] .character-column__row,
    [data-section-id="{{ section.id }}"] .character-column__col {
      grid-template-columns: 1fr;
    }

    [data-section-id="{{ section.id }}"] .character-column__col {
      padding-top: {{ section.settings.padding_y_mobile }}px;
    }

    [data-section-id="{{ section.id }}"] .character-column__text {
      align-items: center;
      text-align: center;
    }
  }

{% endstyle %}

<section data-section-id="{{ section.id }}" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
  <div class="character-column__row">
    <div class="character-column__col character-column__col--1">
      <div class="character-column__text">
        {%- if section.settings.col_1_header != blank -%}
          <h2 class="character-column__header inline-richtext">{{ section.settings.col_1_header }}</h2>
        {%- endif -%}
        {%- if section.settings.col_1_button_text != blank -%}
          <a
            {% if section.settings.col_1_button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.col_1_button_link }}"
            {% endif %}
            class="button tj-new-button button--primary character-column__button--1"
          >
            {{- section.settings.col_1_button_text | escape -}}
          </a>
        {%- endif -%}
      </div>
      <div class="character-column__image-wrap">
        {%- if section.settings.col_1_image != blank -%}
          {{
            section.settings.col_1_image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500', alt: section.settings.col_1_image.alt
          }}
        {%- endif -%}
      </div>
    </div>
    <div class="character-column__col character-column__col--2">
      <div class="character-column__text">
        {%- if section.settings.col_2_header != blank -%}
          <h2 class="character-column__header inline-richtext">{{ section.settings.col_2_header }}</h2>
        {%- endif -%}
        {%- if section.settings.col_2_button_text != blank -%}
          <a
            {% if section.settings.col_2_button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.col_2_button_link }}"
            {% endif %}
            class="button tj-new-button button--primary character-column__button--2"
          >
            {{- section.settings.col_2_button_text | escape -}}
          </a>
        {%- endif -%}
      </div>
      <div class="character-column__image-wrap">
        {%- if section.settings.col_2_image != blank -%}
          {{
            section.settings.col_2_image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500', alt: section.settings.col_2_image.alt
          }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Character Column",
  "enabled_on": {
    "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID (optional)"
    },
    {
      "type": "range",
      "id": "padding_y_desktop",
      "label": "Padding top desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Padding top mobile (px)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "header_font_size_desktop",
      "label": "Header font size desktop (px)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "header_font_size_mobile",
      "label": "Header font size mobile (px)",
      "min": 16,
      "max": 80,
      "step": 1,
      "default": 28
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "color",
      "id": "col_1_bg_color",
      "label": "Column 1 background color",
      "default": "#FFFFFF"
    },
    {
      "type": "html",
      "id": "col_1_header",
      "label": "Column 1 header"
    },
    {
      "type": "color",
      "id": "col_1_header_color",
      "label": "Column 1 header color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "col_1_image",
      "label": "Column 1 image"
    },
    {
      "type": "text",
      "id": "col_1_button_text",
      "label": "Column 1 button text"
    },
    {
      "type": "url",
      "id": "col_1_button_link",
      "label": "Column 1 button link"
    },
    {
      "type": "color",
      "id": "col_1_button_text_color",
      "label": "Column 1 button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "col_1_button_bg_color",
      "label": "Column 1 button background color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "color",
      "id": "col_2_bg_color",
      "label": "Column 2 background color",
      "default": "#FFFFFF"
    },
    {
      "type": "html",
      "id": "col_2_header",
      "label": "Column 2 header"
    },
    {
      "type": "color",
      "id": "col_2_header_color",
      "label": "Column 2 header color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "col_2_image",
      "label": "Column 2 image"
    },
    {
      "type": "text",
      "id": "col_2_button_text",
      "label": "Column 2 button text"
    },
    {
      "type": "url",
      "id": "col_2_button_link",
      "label": "Column 2 button link"
    },
    {
      "type": "color",
      "id": "col_2_button_text_color",
      "label": "Column 2 button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "col_2_button_bg_color",
      "label": "Column 2 button background color",
      "default": "#000000"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Character Column"
    }
  ]
}
{% endschema %}
